<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chagok" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
    </style>
    <style name="Theme.Chagok.DatePicker" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#087457</item>
        <item name="android:datePickerStyle">@style/Widget.Chagok.DatePicker</item>
        <item name="android:fontFamily">@font/chagok_sans</item>
    </style>
    <style name="Widget.Chagok.DatePicker" parent="@android:style/Widget.Material.Light.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
    </style>
</resources>
