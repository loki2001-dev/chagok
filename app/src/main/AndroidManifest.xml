<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
        운영사무국 회신: Normal·Dangerous 범위만 사용한다. signature·privileged 권한은 선언하지 않는다.
        실제로 쓰는 API의 권한만 선언한다 (Pleos App Market 승인 범위).
    -->
    <!-- Odometer.getCurrentDistanceDriven: 누적 주행거리 자동 첨부 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Fuel.registerFuelPercent, EvBattery.registerEvBatteryStateOfCharge: 주유·충전 후보 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Pleos SpeechToText ON_DEVICE -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- Android SpeechRecognizer 대체 경로 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="ai.pleos.playground.service.location.fused" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chagok">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/report_paths" />
        </provider>

        <receiver android:name=".companion.RecordingBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".companion.VehicleMonitorService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started, on-device vehicle diary: continuously observe fuel and battery readings to detect refueling or charging across navigation and application switches. Optional user-enabled local place visit detection using Pleos location. Network downloads place catalogues only; coordinates are never uploaded. No microphone collection in this service." />
        </service>
        <!-- Read-only companion: animated artwork pauses under NO_VIDEO; parked UI is disabled
             under UX restrictions. This declaration is not a Pleos distribution approval. -->
        <activity android:name=".companion.CompanionActivity" android:exported="true"
            android:launchMode="singleTask" android:resizeableActivity="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.PlacesActivity" android:exported="false" />
        <!-- Existing diary/editor/learning screens remain parked-only. -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask">
        </activity>
    </application>
</manifest>
