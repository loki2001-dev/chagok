<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
        운영사무국 회신: Normal·Dangerous 범위만 사용한다. signature·privileged 권한은 선언하지 않는다.
        실제로 쓰는 API의 권한만 선언한다 (Pleos App Market 승인 범위).
    -->
    <!-- Odometer.getCurrentDistanceDriven: 누적 주행거리 자동 첨부 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Fuel.registerFuelPercent, EvBattery.registerEvBatteryStateOfCharge: 주유·충전 후보 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Pleos SpeechToText ON_DEVICE -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- Android SpeechRecognizer 대체 경로 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chagok">

        <!--
            MVP의 일지 확인·일정 편집·비용·학습은 정차 전용이다 (기획서 7장 '주행 중').
            distractionOptimized를 선언하지 않으므로 주행 중에는 플랫폼이 화면을 막는다.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
